# API 1 — administrativa (copiar a apps/api/.env)
API_PORT=4000
DATABASE_URL=postgres://luz:changeme@localhost:5432/luzdeltiempo
BETTER_AUTH_SECRET=cambiar-por-un-valor-largo-aleatorio-de-32-caracteres
BETTER_AUTH_URL=http://localhost:4000
# Orígenes permitidos (panel y web), separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Dirección pública de la web (para los QR de inscripción)
PUBLIC_WEB_URL=https://laluzdeltiempo.org

# Radio (radio-api, API 2): URL, token interno y clave para cifrar contraseñas de locutor (32 bytes base64)
RADIO_API_URL=http://localhost:4100
RADIO_API_TOKEN=
RADIO_SECRET_KEY=
