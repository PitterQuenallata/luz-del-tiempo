{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emisor La Luz del Tiempo",
  "version": "0.2.0",
  "identifier": "org.laluzdeltiempo.emisor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emisor · La Luz del Tiempo",
        "width": 430,
        "height": 760,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./firmar.ps1 %1"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyMkEyNUFCOTQ1QzBGNkMKUldSc0QxeVVxeVVxUWx0L3J1YkV1dlhpWEhYYkIvMzFHbzNQNTczL3RCTlVsbXRscG5ZWCs2VFMK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
