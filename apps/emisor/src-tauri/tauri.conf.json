{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Emisor La Luz del Tiempo",
  "version": "0.1.0",
  "identifier": "org.laluzdeltiempo.emisor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Emisor · La Luz del Tiempo",
        "width": 430,
        "height": 760,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["Spanish"], "displayLanguageSelector": false },
      "wix": { "language": "es-ES" }
    }
  }
}
