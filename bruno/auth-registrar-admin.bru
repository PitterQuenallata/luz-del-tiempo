meta {
  name: Auth - registrar admin de prueba
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Origin: http://localhost:3000
}

body:json {
  {
    "name": "Admin de prueba",
    "email": "{{testUserEmail}}",
    "password": "{{testUserPassword}}"
  }
}

assert {
  res.status: in [200, 422]
}
