# Copiar a infra/radio/.env y cambiar todas las contraseñas.

# Contraseña interna con la que Liquidsoap publica en Icecast (nadie más la usa)
ICECAST_SOURCE_PASSWORD=cambiar-fuente
# Panel de administración de Icecast (http://<ip>:8000/admin/)
ICECAST_ADMIN_PASSWORD=cambiar-admin
ICECAST_HOSTNAME=localhost
ICECAST_MAX_CLIENTS=500

# Token que la API 1 manda en "Authorization: Bearer ..." a la radio-api
RADIO_API_TOKEN=cambiar-por-un-token-largo-aleatorio

# Dirección con la que los oyentes llegan a Icecast (en la red de casa: la IP de esta PC)
PUBLIC_STREAM_BASE=http://192.168.1.10:8000
